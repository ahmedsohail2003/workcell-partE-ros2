# Scripts in this repo execute inside WSL (bash/python) — a CRLF checkout
# breaks every one of them with cryptic $'\r' errors. Force LF for anything
# that crosses the Windows/Linux boundary.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.srv text eol=lf
*.xml text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.md text eol=lf
CMakeLists.txt text eol=lf

*.gif binary
*.png binary
*.pgm binary
